# Telegram
BOT_TOKEN=                      # токен от @BotFather
ADMIN_TG_IDS=                   # через запятую, доступ к /admin

# Microsoft / Azure — регистрация приложения на portal.azure.com
# Scope: XboxLive.signin XboxLive.offline_access
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
OAUTH_REDIRECT_URL=             # https://ваш-домен/auth/callback
OAUTH_LISTEN_HOST=0.0.0.0
OAUTH_LISTEN_PORT=8080

# Шифрование refresh-токенов в БД
# сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Steam (опционально — /connect_steam без него отвечает «не настроено»).
# Никакого OAuth не нужно, один ключ на всего бота: steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Интервалы поллера в секундах (SPEC 5.2, 5.3)
PRESENCE_INTERVAL_IN_GAME=60    # человек в игре
PRESENCE_INTERVAL_ONLINE=120    # в сети, но не в игре
PRESENCE_INTERVAL_OFFLINE=300   # не в сети
PRESENCE_INTERVAL_IDLE=900      # не в сети больше 2 часов
ACHIEVEMENT_POLL_INTERVAL=120   # опрос ачивок, пока человек в игре
TOKEN_REFRESH_MARGIN=300        # обновлять токен, если истекает раньше чем через N секунд

# Ограничение параллельного бэкфила (SPEC 5.6)
BACKFILL_CONCURRENCY=2

# Прочее
DB_PATH=data/bot.db
LOG_LEVEL=INFO
TZ=Europe/Moscow                # стартовое значение app_settings.timezone

# Догон после простоя (SPEC 5.8)
CATCHUP_PUBLISH_WINDOW_HOURS=24  # публикуем пропущенное не старше N часов
CATCHUP_MAX_TITLES=20            # сколько игр смотрим за один догон
